ARG RUNNER_BASE
FROM ${RUNNER_BASE}
COPY toolchain/ /opt/home-android/
COPY manifest.json /opt/home-android/provenance/manifest.json
COPY verify-rust-target.mjs /opt/home-android/provenance/verify-rust-target.mjs
ENV JAVA_HOME=/opt/home-android/jdk \
    ANDROID_HOME=/opt/home-android/sdk \
    ANDROID_SDK_ROOT=/opt/home-android/sdk \
    NDK_HOME=/opt/home-android/sdk/ndk/29.0.14206865 \
    CARGO_HOME=/workspace/src-tauri/target/android-cache/cargo \
    GRADLE_USER_HOME=/workspace/src-tauri/target/android-cache/gradle \
    ANDROID_USER_HOME=/workspace/src-tauri/target/android-cache/android
ENV PATH="/opt/home-android/jdk/bin:/opt/home-android/rust/bin:/opt/home-android/sdk/cmdline-tools/pinned/bin:${PATH}"
ARG RUST_VERSION
ARG JDK_VERSION
# verify-rust-target.mjs compiles and links synthetic std-using programs for
# both x86_64-linux-android and aarch64-linux-android with their matching NDK
# API-24 linkers and checks each resulting ELF machine; neither binary runs.
RUN test "$(rustc --version | cut -d ' ' -f 2)" = "$RUST_VERSION" && \
    test "$(javac -version 2>&1)" = "javac $JDK_VERSION" && \
    node /opt/home-android/provenance/verify-rust-target.mjs && \
    java -version && cargo --version && \
    "$NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/clang" --version && \
    "$NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android24-clang" --version && \
    "$NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android24-clang" --version
