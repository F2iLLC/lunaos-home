{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Luna OS Home Preview",
  "version": "0.1.0",
  "identifier": "io.github.f2illc.lunaos.home.preview",
  "build": {
    "beforeBuildCommand": "npm run build:native",
    "beforeDevCommand": "npm run build:native",
    "frontendDist": "../native-dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Luna OS Home — Fictional preview", "width": 1100, "height": 800, "minWidth": 320, "minHeight": 480 }],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'none'; img-src 'self' asset: http://asset.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "shortDescription": "Fictional family draft preview. No secure vault storage."
  }
}
