<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resting_screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/resting_gradient"
    android:clickable="true" android:focusable="true"
    android:contentDescription="@string/resting_open_home">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/resting_sky" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
        android:paddingLeft="24dp" android:paddingRight="24dp">
        <TextClock android:id="@+id/resting_clock"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:fontFamily="sans-serif-light"
            android:textSize="96sp" android:textColor="#FFF5EF"
            android:format12Hour="h:mm a" android:format24Hour="HH:mm"
            android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/resting_greeting"
            android:fontFamily="sans-serif-light" android:textSize="24sp"
            android:textColor="#EEE0EC" />
    </LinearLayout>
</FrameLayout>
